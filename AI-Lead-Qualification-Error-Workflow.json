        "color": "#2F2D2E"
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -128,
        -272
      ],
      "name": "Sticky Note"
    },
    {
      "parameters": {
        "sendTo": "demo@example.com",
        "subject": "=[{{ $json.workflow.name }}] - Workflow Execution Failed",
        "message": "=<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n</head>\n<body style=\"margin:0; padding:24px; background-color:#f4f6f8; font-family:Arial,sans-serif; color:#333333;\">\n  <div style=\"max-width:600px; margin:0 auto; background:#ffffff; border:1px solid #e5e7eb; border-radius:10px; overflow:hidden;\">\n    <div style=\"background:#b42318; padding:22px 25px; color:#ffffff;\">\n      <h2 style=\"margin:0; font-size:21px;\">Workflow Execution Failed</h2>\n      <p style=\"margin:8px 0 0; font-size:13px;\">{{ $json.workflow.name }} | Automated Error Monitoring</p>\n    </div>\n    <div style=\"padding:25px;\">\n      <p style=\"font-size:15px; line-height:1.6;\">Hello,</p>\n      <p style=\"font-size:14px; line-height:1.6; color:#555555;\">\n        An error occurred during the execution of\n        <strong>{{ $json.workflow.name }}</strong>.\n        Please review the details below and take the necessary corrective action.\n      </p>\n      <h3 style=\"font-size:16px; margin-top:25px; color:#333333;\">Error Details</h3>\n      <table style=\"width:100%; border-collapse:collapse; font-size:13px;\">\n        <tr>\n          <td style=\"padding:12px; background:#f4f6f8; font-weight:bold; width:35%;\">Workflow</td>\n          <td style=\"padding:12px; border-bottom:1px solid #eeeeee;\">{{ $json.workflow.name }}</td>\n        </tr>\n        <tr>\n          <td style=\"padding:12px; background:#f4f6f8; font-weight:bold;\">Failed Node</td>\n          <td style=\"padding:12px; border-bottom:1px solid #eeeeee;\">{{ $json.execution.lastNodeExecuted }}</td>\n        </tr>\n        <tr>\n          <td style=\"padding:12px; background:#f4f6f8; font-weight:bold;\">Error Message</td>\n          <td style=\"padding:12px; border-bottom:1px solid #eeeeee; color:#b42318; word-break:break-word;\">{{ $json.execution.error.message }}</td>\n        </tr>\n        <tr>\n          <td style=\"padding:12px; background:#f4f6f8; font-weight:bold;\">Execution ID</td>\n          <td style=\"padding:12px; border-bottom:1px solid #eeeeee;\">{{ $json.execution.id }}</td>\n        </tr>\n        <tr>\n          <td style=\"padding:12px; background:#f4f6f8; font-weight:bold;\">Execution Mode</td>\n          <td style=\"padding:12px; border-bottom:1px solid #eeeeee;\">{{ $json.execution.mode }}</td>\n        </tr>\n      </table>
      <div style=\"margin-top:25px; text-align:center;\">
        <a href=\"{{ $json.execution.url }}\" style=\"display:inline-block; padding:12px 22px; background:#2563eb; color:#ffffff; text-decoration:none; border-radius:6px; font-size:14px; font-weight:bold;\">View Failed Execution</a>
      </div>
      <p style=\"font-size:13px; color:#666666; margin-top:25px; line-height:1.5;\">
        Please investigate the failure, resolve the underlying issue, and restore normal workflow operation.
      </p>
    </div>
    <div style=\"background:#f4f6f8; padding:16px 25px; text-align:center; font-size:11px; color:#777777;\">
      Automated Error Notification<br>
      {{ $json.workflow.name }}
    </div>
  </div>
</body>
</html>",
        "options": {}
      },
